<Window x:Class="Algorithms_Simulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Algorithms_Simulation"
        xmlns:vm="clr-namespace:Algorithms_Simulation.ViewModels"
        mc:Ignorable="d"
        Title="Vizualizace razeni" Height="600" Width="900">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#CBD5F5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style x:Key="ArrayItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompared}" Value="True">
                    <Setter Property="Background" Value="#FDE047" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSorted}" Value="True">
                    <Setter Property="Background" Value="#86EFAC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSwapped}" Value="True">
                    <Setter Property="Background" Value="#FDBA74" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPivot}" Value="True">
                    <Setter Property="Background" Value="#C4B5FD" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryRowBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="#EFF6FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Background="#F1F5F9" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Algoritmus" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Algorithms}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedAlgorithm}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,16,0">
                    <TextBlock Text="Vstup" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Start" Command="{Binding StartCommand}" />
                    <Button Content="Reset" Command="{Binding ResetCommand}" Margin="0" Background="#64748B" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button Content="Generovat" Command="{Binding GenerateRandomCommand}" Background="#10B981" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.3*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Aktualni krok" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding ArrayItems}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ArrayItemBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Index}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="0" Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Historie pruchodu" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding HistoryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HistoryRowBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ArrayItemBorderStyle}" Padding="6" Margin="3">
                                                            <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

                <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="White" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Vysvetleni" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding CurrentExplanation}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <TextBlock Text="Popis algoritmu" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding SelectedAlgorithm.Description}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <TextBlock Text="Pseudokod" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding SelectedAlgorithm.Pseudocode}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,12" />

                    <TextBlock Text="Slozitost" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding SelectedAlgorithm.TimeComplexity}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedAlgorithm.SpaceComplexity}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <TextBlock Text="Statistiky" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Porovnani:" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentStep.Comparisons}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Swapy:" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentStep.Swaps}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Zapisy:" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentStep.Writes}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Predchozi" Command="{Binding PreviousStepCommand}" />
                <Button Grid.Column="1" Content="Dalsi" Command="{Binding NextStepCommand}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Krok" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} / {1}">
                                <Binding Path="CurrentStepDisplay" />
                                <Binding Path="Steps.Count" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
